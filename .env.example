# Solana Memecoin Trader Configuration
# Copy this file to .env and fill in your actual values

# ==============================================================================
# WALLET CONFIGURATION (REQUIRED for Live Trading)
# ==============================================================================
# Your Solana wallet private key (base58 encoded)
# IMPORTANT: Keep this secret! Never commit your actual .env file to git
SOLANA_PRIVATE_KEY=

# Your Solana wallet public key (base58 encoded)
SOLANA_PUBLIC_KEY=

# ==============================================================================
# TRADING MODE
# ==============================================================================
# Enable/disable trading (set to true when ready to trade)
TRADING_ENABLED=true

# Dry run mode simulates trades without executing real transactions
# Set to false for live trading (USE WITH CAUTION - REAL MONEY AT RISK!)
DRY_RUN_MODE=true

# ==============================================================================
# SOLANA RPC ENDPOINT (OPTIONAL)
# ==============================================================================
# Default: https://api.mainnet-beta.solana.com
# For production, consider using a faster RPC provider like:
# - Helius: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# - QuickNode: https://YOUR_ENDPOINT.quiknode.pro/YOUR_KEY/
# - Alchemy: https://solana-mainnet.g.alchemy.com/v2/YOUR_KEY
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ==============================================================================
# TELEGRAM NOTIFICATIONS (OPTIONAL)
# ==============================================================================
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Your Telegram chat ID (send a message to @userinfobot to get it)
TELEGRAM_CHAT_ID=

# ==============================================================================
# NOTES
# ==============================================================================
# 1. The bot uses DexScreener API for token discovery (no API key needed)
# 2. The bot uses Jupiter API for trade execution (no API key needed)
# 3. Run without wallet keys configured to use BACKTEST MODE
# 4. Always test with DRY_RUN_MODE=true before live trading
# 5. Start with small position sizes and gradually increase as you gain confidence
# 6. Monitor the bot regularly and be prepared to stop it if needed
